# ===================== 通用过滤规则 =====================
# 敏感配置文件（核心！禁止上传）
application.yml
application-local.yml
application.properties
application-prod.yml
application-prod.properties
.env
.env.local
.env.production
.env.*.local
*.key
*.pem
*.jks  # Java证书文件
*.pfx  # SSL证书
config/prod/  # 生产环境配置目录

# 日志文件
*.log
logs/
log/
*.trace
*.out

# 临时文件
*.tmp
*.temp
*.cache
.DS_Store  # Mac系统隐藏文件
Thumbs.db  # Windows系统缩略图

# ===================== Java后端（cozy-coffee-backend） =====================
# Maven/Gradle编译产物
target/
build/
classes/
resources/
# 但保留 src/test/resources/ 和 src/main/resources/（源码资源目录）
!**/src/test/resources/
!**/src/main/resources/
*.jar
*.war
*.ear

# Maven依赖缓存
.m2/
.gradle/
gradle-wrapper.jar

# IDE配置（仅本地保留，不上传）
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ===================== 前端项目（如cozy-coffee-frontend） =====================
# Node.js依赖（核心！禁止上传）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 前端编译产物
dist/
build/
out/
dist/assets/
*.min.js
*.min.css

# 前端缓存/锁文件（可传package-lock.json/yarn.lock，这里过滤本地缓存）
package-lock.json.bak
yarn.lock.bak
.pnpm-store/

# ===================== 数据库相关 =====================
# SQL脚本备份（仅传原始migrate_data.sql，过滤备份）
*.sql.bak
*.sql.backup
data/  # 本地数据库数据目录

# ===================== 其他冗余文件 =====================
# 测试报告
test-report/
coverage/
# 打包压缩文件
*.zip
*.rar
*.7z

# ===================== Claude Code worktree =====================
# 本地 worktree 目录，不应提交
.claude/worktrees/
.worktrees/

# 本地上传文件（OSS 未配置时的本地存储）
uploads/

# 本地图片静态资源（OSS 到期临时放入网关 classpath，不入库）
cozy-coffee-backend/cozy-gateway/src/main/resources/static/images/

# ===================== AI 工具 / 编辑器本地产物 =====================
# Claude Code superpowers 插件的会话产物：头脑风暴原型 HTML + state/server-info
# （后者含本机绝对路径与本机端口，属工具状态而非项目内容）
.superpowers/
# superpowers 插件的计划/规格文档（2026-07 建仓期的过程记录，不属对外项目文档）
docs/superpowers/
# impeccable 工具的钩子缓存与本地配置（此前只写在 .git/info/exclude —— 那是本机私有的，
# 不随仓库走，别人 clone 下来会看到这些文件是未跟踪的）
.impeccable/
# Cursor 编辑器规则（CodeGraph 用法提示，属编辑器本地配置）
.cursor/
# CodeGraph 索引状态：数据库、日志、socket 与索引配置全属本机，整目录不入库
.codegraph/

# ===================== 根目录误生成 / 工具模板 =====================
# 误跑 npm init 生成的清单。各子应用有自己的 package.json，
# CI 用 working-directory 进子目录跑，不经根清单 —— 故根级这两个必须带前导斜杠限制，
# 否则会连子应用的 package.json 一起忽略
/package.json
/package-lock.json
# 设计工具输出的通用 brief 模板（项目文档统一放 docs/）
/PRODUCT.md
