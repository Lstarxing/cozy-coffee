# 开发环境配置
# VITE_API_BASE_URL 为空时使用相对路径 /api，由 Vite dev server proxy 转发到后端
# 如需直连后端（跳过 proxy），设为 http://localhost:8080
VITE_API_BASE_URL=

# Vite dev server proxy 目标 - 后端 Gateway 地址
VITE_API_TARGET=http://localhost:8080

# OSS 静态资源基址（设置后首页/关于页/菜单图片走 OSS，留空则用本地占位图）
VITE_ASSET_BASE_URL=https://cozycoffee-srx.oss-cn-hangzhou.aliyuncs.com
VITE_MENU_IMAGE_BASE=https://cozycoffee-srx.oss-cn-hangzhou.aliyuncs.com/images/home/menu
