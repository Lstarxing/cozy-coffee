# 开发环境配置
# VITE_API_BASE_URL 为空时使用相对路径 /api，由 Vite dev server proxy 转发到后端
# 如需直连后端（跳过 proxy），设为 http://localhost:8080
VITE_API_BASE_URL=

# Vite dev server proxy 目标 - 后端 Gateway 地址
VITE_API_TARGET=http://localhost:8080

# OSS 静态资源基址（OSS 到期临时留空用本地图；上线配好 OSS 后填回 OSS 地址）
VITE_ASSET_BASE_URL=
VITE_MENU_IMAGE_BASE=

# 图片统一基址：DB 存相对路径，前端统一拼接此基址
# 本地托管时指向网关（classpath /images 静态资源）；上线配好 OSS 后改为 OSS 域名
VITE_IMAGE_BASE_URL=http://localhost:8080
