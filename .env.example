# Compose project name
COMPOSE_PROJECT_NAME=cozycoffee

# Infrastructure
MYSQL_ROOT_PASSWORD=666
MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_PORT=8848
TIMEZONE=Asia/Shanghai

# MySQL initialization mode:
# full   -> import schema + demo data from sql files
# schema -> import schema only (skip INSERT INTO lines)
MYSQL_INIT_MODE=full

# Gateway / Provider exposed ports
GATEWAY_PORT=8080
USER_PROVIDER_HTTP_PORT=8081
MEMBER_PROVIDER_HTTP_PORT=8082
ORDER_PROVIDER_HTTP_PORT=8083
MALL_PROVIDER_HTTP_PORT=8084

USER_PROVIDER_DUBBO_PORT=20881
MEMBER_PROVIDER_DUBBO_PORT=20882
ORDER_PROVIDER_DUBBO_PORT=20883
MALL_PROVIDER_DUBBO_PORT=20884
