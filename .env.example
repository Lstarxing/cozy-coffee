# Compose project name
COMPOSE_PROJECT_NAME=cozycoffee

# Infrastructure
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
TIMEZONE=Asia/Shanghai

# MySQL initialization mode:
# full   -> import schema + demo data from sql files
# schema -> import schema only (skip INSERT INTO lines)
MYSQL_INIT_MODE=full

# Gateway / Provider exposed ports
GATEWAY_PORT=8080
USER_PROVIDER_HTTP_PORT=8081
MEMBER_PROVIDER_HTTP_PORT=8082
ORDER_PROVIDER_HTTP_PORT=8083
MALL_PROVIDER_HTTP_PORT=8084

USER_PROVIDER_DUBBO_PORT=20881
MEMBER_PROVIDER_DUBBO_PORT=20882
ORDER_PROVIDER_DUBBO_PORT=20883
MALL_PROVIDER_DUBBO_PORT=20884

# 对象存储：本项目统一 MinIO（S3 兼容；compose 内网地址）
# 本地基础设施自带 minio 服务，root 账号见 docker-compose.yml（MINIO_ROOT_USER/PASSWORD，默认 minioadmin）
STORAGE_TYPE=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=cozycoffee
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_ACCESS_KEY_SECRET=minioadmin123
STORAGE_DIR_PREFIX=images/
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/cozycoffee
# 说明：网关 storage.type 仍支持 oss / local（见 StorageProperties），但本项目不再使用阿里云 OSS，
#       真实 OSS AK/Secret 一律不入库；确需时只写本机 .env（已 gitignore）。
