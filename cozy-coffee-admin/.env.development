# 开发环境配置
# VITE_API_BASE_URL 为空时使用相对路径 /api，由 Vite dev server proxy 转发到后端
VITE_API_BASE_URL=
# Vite dev server proxy 目标 - 后端 Gateway 地址
VITE_API_TARGET=http://localhost:8080

# 图片统一基址：本地 MinIO（DB 相对路径 .webp + 此基址 = MinIO 对象）
# 上线：改为服务器 Nginx 反代 http://<公网IP>/media/cozycoffee（见仓库 .env.prod.example）
VITE_IMAGE_BASE_URL=http://127.0.0.1:9000/cozycoffee
