# 生产构建（部署前取消注释填入真实值）
# VITE_H5_API_BASE_URL=https://<域名>/api
# VITE_API_BASE_URL=https://<域名>/api
VITE_H5_API_BASE_URL=/api
VITE_API_BASE_URL=http://127.0.0.1:8080/api

# 图片基址：上线改为服务器 Nginx /media 反代到 MinIO（见仓库 .env.prod.example）
# VITE_IMAGE_BASE_URL=https://<域名>/media/cozycoffee
VITE_IMAGE_BASE_URL=http://127.0.0.1:9000/cozycoffee
