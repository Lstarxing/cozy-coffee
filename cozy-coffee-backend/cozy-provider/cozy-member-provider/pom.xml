<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cozy</groupId>
        <artifactId>cozy-provider</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>cozy-member-provider</artifactId>
    <packaging>jar</packaging>
    <description>会员服务Provider - Dubbo服务实现</description>

    <dependencies>
        <!-- 会员服务API -->
        <dependency>
            <groupId>com.cozy</groupId>
            <artifactId>cozy-member-api</artifactId>
        </dependency>
        
        <!-- 用户服务API (用于获取生日用户信息) -->
        <dependency>
            <groupId>com.cozy</groupId>
            <artifactId>cozy-user-api</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- 订单服务API (用于获取月度统计) -->
        <dependency>
            <groupId>com.cozy</groupId>
            <artifactId>cozy-order-api</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- 积分商城服务API -->
        <dependency>
            <groupId>com.cozy</groupId>
            <artifactId>cozy-mall-api</artifactId>
        </dependency>

        <!-- 公共模块 -->
        <dependency>
            <groupId>com.cozy</groupId>
            <artifactId>cozy-common</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MyBatis Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Flyway：版本化数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Dubbo Spring Boot Starter -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>

        <!-- Nacos Discovery -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- RocketMQ：异步消费订单完成事件（积分/EXP/首单/月度任务） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>${rocketmq-spring.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>com.cozy.member.MemberProviderApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
